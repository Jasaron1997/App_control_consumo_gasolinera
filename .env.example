# Copiá este archivo a .env (gitignored) y ajustá los valores si querés.
# Todo esto es SOLO para la instancia local de Docker (docker-compose.yml) —
# nunca corresponde a producción/Azure SQL.

# Password del usuario "sa" del contenedor. Requisito de SQL Server: 8+
# caracteres, con mayúscula, minúscula, dígito y símbolo.
MSSQL_SA_PASSWORD=GasolinaLocal_2026!

# Password del login de bajo privilegio que usaría la API (mismo rol que
# database/04_Crear_Login_App.sql crea en Azure SQL).
GASOLINA_API_DB_PASSWORD=GasolinaApiLocal_2026!

# Usuario que siembra database/docker-setup.sh (equivalente a
# database/03_Seed_Usuario.sql, pero generando el hash de BCrypt solo,
# sin editar nada a mano).
SEED_USUARIO_NOMBRE="Usuario de Prueba"
SEED_USUARIO_EMAIL=test@local.dev
SEED_USUARIO_PASSWORD=Test1234!
